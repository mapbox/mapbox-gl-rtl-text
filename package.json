{
  "name": "@mapbox/mapbox-gl-rtl-text",
  "version": "0.4.0",
  "description": "Add support for RTL languages to mapbox-gl-js.",
  "license": "BSD-2-Clause",
  "author": "Mapbox",
  "repository": {
    "url": "git://github.com/mapbox/mapbox-gl-rtl-text.git",
    "type": "git"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./rtl.js": "./src/rtl.js",
    "./mapbox-gl-rtl-text.wasm": "./dist/mapbox-gl-rtl-text.wasm"
  },
  "scripts": {
    "build:icu": "./build_icu.sh",
    "start": "vite --config vite.config.js .",
    "pretest": "eslint src/*.js test.js",
    "test": "node --import ./wasm-loader.js --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-mourner": "^5.0.1",
    "mapbox-gl": "^3.32.0",
    "vite": "^8.3.2"
  },
  "files": [
    "src/*.js",
    "dist/mapbox-gl-rtl-text.wasm"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
