{
  "name": "@mapbox/mapbox-gl-rtl-text",
  "version": "1.0.0",
  "description": "Add support for RTL languages to mapbox-gl-js.",
  "license": "BSD-2-Clause",
  "author": "Mapbox",
  "repository": {
    "url": "git://github.com/mapbox/mapbox-gl-rtl-text.git",
    "type": "git"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "exports": {
    ".": "./src/index.js",
    "./rtl.js": "./src/rtl.js",
    "./mapbox-gl-rtl-text.wasm": "./dist/mapbox-gl-rtl-text.wasm"
  },
  "scripts": {
    "start": "python3 -m http.server 5173",
    "pretest": "make && eslint src/*.js test.js",
    "test": "node --import ./wasm-loader.js --test test.js",
    "prepublishOnly": "npm test",
    "build": "make"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-mourner": "^5.0.1"
  },
  "files": [
    "src/*.js",
    "src/*.d.ts",
    "dist/mapbox-gl-rtl-text.wasm"
  ]
}
